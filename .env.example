# Nebulus Prime Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is in .gitignore.

# Ollama Configuration
# OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_API_BASE_URL=http://ollama:11434/api

# Open WebUI Configuration
# Generate a secret key with: openssl rand -base64 32
WEBUI_SECRET_KEY=change_this_to_a_secure_random_string
WEBUI_NAME="Black Box AI"

# MCP Server Configuration
# Store sensitive keys via: nebulus secrets store <key_name>
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# SMTP Configuration (for scheduler email reports)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# TabbyAPI Authentication
# Generate with: openssl rand -hex 32
TABBY_API_KEY=

# ChromaDB Authentication
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
CHROMA_AUTH_TOKEN=
