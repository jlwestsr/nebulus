:root {
    /* Dimensions */
    --sidebar-width: 260px;
    --sidebar-collapsed-width: 60px;

    /* Light Theme (Default) */
    --bg-primary: #ffffff;
    --bg-secondary: #f6f8fa;
    --bg-hover: #f3f4f6;
    --text-primary: #1F2328;
    --text-secondary: #656d76;
    --border-color: #d0d7de;
    --accent-color: #F80061;
    --btn-text: #ffffff;
    --btn-hover-opacity: 0.9;
    --shadow-color: rgba(0, 0, 0, 0.1);
}

html.dark {
    /* Dark Theme Overrides */
    --bg-primary: #0d1117;
    --bg-secondary: #161b22;
    --bg-hover: #1f242c;
    --text-primary: #e6edf3;
    --text-secondary: #7d8590;
    --border-color: #30363d;
    --shadow-color: rgba(0, 0, 0, 0.5);
}

body {
    transition: padding-left 0.3s ease, background-color 0.3s ease, color 0.3s ease;
    padding-left: var(--sidebar-width) !important;
    background-color: var(--bg-primary);
    color: var(--text-primary);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    margin: 0;
}

body.sidebar-collapsed {
    padding-left: var(--sidebar-collapsed-width) !important;
}

/* Sidebar */
#nebulus-sidebar {
    position: fixed;
    top: 0;
    left: 0;
    height: 100vh;
    width: var(--sidebar-width);
    background-color: var(--bg-primary);
    border-right: 1px solid var(--border-color);
    z-index: 9999;
    display: flex;
    flex-direction: column;
    padding: 10px;
    transition: width 0.3s ease, background-color 0.3s ease;
    overflow: hidden;
}

body.sidebar-collapsed #nebulus-sidebar {
    width: var(--sidebar-collapsed-width);
}

/* Logo Area */
.sidebar-header {
    display: flex;
    align-items: center;
    padding: 10px;
    margin-bottom: 20px;
    height: 50px;
    overflow: hidden;
}

.logo-text {
    color: var(--text-primary);
    font-size: 1.1rem;
    font-weight: 600;
    white-space: nowrap;
    opacity: 1;
    transition: opacity 0.2s;
}

body.sidebar-collapsed .logo-text {
    opacity: 0;
    pointer-events: none;
}

/* Navigation Items */
.nav-item {
    display: flex;
    align-items: center;
    padding: 10px;
    color: var(--text-secondary);
    text-decoration: none;
    border-radius: 6px;
    margin-bottom: 4px;
    cursor: pointer;
    transition: background-color 0.2s, color 0.2s;
    white-space: nowrap;
    overflow: hidden;
}

.nav-item:hover {
    background-color: var(--bg-hover);
    color: var(--text-primary);
}

.nav-item.active {
    background-color: var(--bg-secondary);
    color: var(--text-primary);
    border-left: 3px solid var(--accent-color);
}

.nav-icon {
    min-width: 24px;
    display: flex;
    justify-content: center;
    margin-right: 12px;
    font-size: 1.2rem;
}

.nav-label {
    opacity: 1;
    transition: opacity 0.2s;
}

body.sidebar-collapsed .nav-label {
    opacity: 0;
}

/* New Chat Button */
.new-chat-btn {
    display: flex;
    align-items: center;
    padding: 10px;
    margin: 10px 0 20px 0;
    border: 1px solid var(--border-color);
    border-radius: 6px;
    color: var(--text-primary);
    cursor: pointer;
    transition: background-color 0.2s;
}

.new-chat-btn:hover {
    background-color: var(--bg-hover);
}

body.sidebar-collapsed .new-chat-btn {
    justify-content: center;
    padding: 10px 0;
}

body.sidebar-collapsed .new-chat-btn span {
    display: none;
}

/* Toggle Button */
.toggle-btn {
    position: absolute;
    top: 15px;
    right: 10px;
    color: var(--text-secondary);
    cursor: pointer;
    padding: 5px;
    display: none;
}

#nebulus-sidebar:hover .toggle-btn {
    display: block;
}

/* Divider */
.divider {
    height: 1px;
    background-color: var(--border-color);
    margin: 10px 0;
}

/* User Profile at Bottom */
.user-profile {
    margin-top: auto;
    display: flex;
    align-items: center;
    padding: 10px;
    color: var(--text-primary);
    cursor: pointer;
}

.user-avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background-color: var(--accent-color);
    margin-right: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    color: #fff;
}

/* Dashboard / Empty State */
#nebulus-dashboard {
    position: fixed;
    top: 0;
    left: var(--sidebar-width);
    width: calc(100% - var(--sidebar-width));
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--bg-primary);
    z-index: 50;
    transition: left 0.3s ease, width 0.3s ease, background-color 0.3s ease;
}

body.sidebar-collapsed #nebulus-dashboard {
    left: var(--sidebar-collapsed-width);
    width: calc(100% - var(--sidebar-collapsed-width));
}

.dashboard-content {
    text-align: center;
    max-width: 800px;
    width: 100%;
}

.dashboard-logo-container {
    margin-bottom: 20px;
}

.dashboard-logo {
    font-size: 3rem;
    font-weight: bold;
    color: var(--text-primary);
    display: inline-block;
    background: var(--bg-secondary);
    border-radius: 50%;
    width: 80px;
    height: 80px;
    line-height: 80px;
    margin-bottom: 10px;
}

.current-model-display {
    font-size: 1.2rem;
    color: var(--text-secondary);
    font-weight: 500;
}

.dashboard-greeting {
    font-size: 1.5rem;
    color: var(--text-primary);
    margin-bottom: 40px;
    font-weight: 500;
}

/* Dashboard Input */
.dashboard-input-wrapper {
    width: 100%;
    max-width: 600px;
    margin: 0 auto 30px auto;
}

.dashboard-input-container {
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 24px;
    display: flex;
    align-items: center;
    padding: 10px 15px;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
    transition: box-shadow 0.2s, border-color 0.2s;
}

.dashboard-input-container:focus-within {
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
    border-color: var(--accent-color);
}

#dashboard-input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    color: var(--text-primary);
    font-size: 1rem;
    padding: 5px;
}

.input-actions {
    display: flex;
    gap: 8px;
}

.input-action-btn {
    background: transparent;
    border: none;
    color: var(--text-secondary);
    cursor: pointer;
    padding: 4px;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.input-action-btn:hover {
    color: var(--text-primary);
    background-color: var(--bg-hover);
}

.suggestions-grid {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 600px;
    margin: 0 auto;
    width: 100%;
}

.suggestion-card {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    padding: 10px 15px;
    text-align: left;
    cursor: pointer;
    transition: background-color 0.2s;
    display: flex;
    flex-direction: column;
}

.suggestion-card:hover {
    background-color: var(--bg-hover);
}

.suggestion-title {
    color: var(--text-primary);
    font-weight: 600;
    font-size: 0.95rem;
    margin-bottom: 2px;
}

.suggestion-desc {
    color: var(--text-secondary);
    font-size: 0.85rem;
    opacity: 0.8;
}

/* Header Model Selector */
#model-selector-container {
    position: fixed;
    top: 15px;
    right: 80px;
    z-index: 1000;
}

#model-selector {
    background-color: var(--bg-secondary);
    color: var(--text-primary);
    border: 1px solid var(--border-color);
    border-radius: 6px;
    padding: 6px 12px;
    font-size: 0.9rem;
    outline: none;
    cursor: pointer;
    transition: border-color 0.2s;
}

#model-selector:hover {
    border-color: var(--text-secondary);
}

#model-selector option {
    background-color: var(--bg-secondary);
}

/* Search Modal */
#search-modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background-color: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(2px);
    z-index: 20000;
    display: none;
    align-items: center;
    justify-content: center;
}

#search-modal-overlay.open {
    display: flex;
}

#search-modal {
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    width: 600px;
    max-width: 90%;
    max-height: 80vh;
    display: flex;
    flex-direction: column;
    box-shadow: 0 20px 50px var(--shadow-color);
}

.search-header {
    padding: 15px;
    border-bottom: 1px solid var(--border-color);
    display: flex;
    align-items: center;
}

#search-input {
    background: transparent;
    border: none;
    color: var(--text-primary);
    font-size: 1.1rem;
    width: 100%;
    outline: none;
    padding: 5px;
}

.search-results {
    padding: 10px;
    overflow-y: auto;
    flex: 1;
    min-height: 100px;
}

.search-result-item {
    padding: 12px;
    border-radius: 6px;
    cursor: pointer;
    border-bottom: 1px solid var(--border-color);
    transition: background 0.2s;
}

.search-result-item:last-child {
    border-bottom: none;
}

.search-result-item:hover {
    background-color: var(--bg-hover);
}

.result-title {
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 4px;
    font-size: 0.95rem;
}

.result-snippet {
    color: var(--text-secondary);
    font-size: 0.85rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    line-height: 1.4;
}

.result-meta {
    font-size: 0.75rem;
    color: var(--text-secondary);
    margin-top: 6px;
}

/* Theme Toggle Button */
#nebulus-theme-toggle {
    position: fixed;
    top: 15px;
    right: 20px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    color: var(--text-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10001;
    /* Higher than model selector */
    transition: background-color 0.2s, transform 0.2s;
}

#nebulus-theme-toggle:hover {
    background-color: var(--bg-hover);
    transform: rotate(15deg);
}

/* Notes App Styles */
#notes-app {
    padding: 80px 20px 20px 80px;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    gap: 20px;
    height: 100vh;
    box-sizing: border-box;
}

.notes-list {
    width: 300px;
    background: var(--bg-secondary);
    border-radius: 8px;
    border: 1px solid var(--border-color);
    overflow-y: auto;
    padding: 10px;
    display: flex;
    flex-direction: column;
    gap: 5px;
}

.notes-editor {
    flex: 1;
    background: var(--bg-secondary);
    border-radius: 8px;
    border: 1px solid var(--border-color);
    display: flex;
    flex-direction: column;
    padding: 20px;
}

.note-item {
    padding: 10px;
    border-radius: 6px;
    cursor: pointer;
    transition: background 0.2s;
    color: var(--text-secondary);
}

.note-item:hover,
.note-item.active {
    background: var(--bg-hover);
    color: var(--text-primary);
}


.note-item .date {
    font-size: 0.75rem;
    color: var(--text-secondary);
    margin-top: 4px;
}

.note-item .snippet {
    font-size: 0.8rem;
    color: var(--text-secondary);
    margin-top: 4px;
    opacity: 0.8;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

input.note-title {
    background: transparent;
    border: none;
    font-size: 1.5rem;
    color: var(--text-primary);
    width: 100%;
    margin-bottom: 20px;
    outline: none;
    font-weight: bold;
}

textarea.note-content {
    background: transparent;
    border: none;
    width: 100%;
    flex: 1;
    color: var(--text-primary);
    font-size: 1rem;
    line-height: 1.5;
    resize: none;
    outline: none;
    font-family: monospace;
}

/* Markdown Preview Typography */
.note-preview {
    flex: 1;
    overflow-y: auto;
    color: var(--text-primary);
    line-height: 1.6;
}

.note-preview h1,
.note-preview h2,
.note-preview h3 {
    margin-top: 1em;
    margin-bottom: 0.5em;
    font-weight: 600;
}

.note-preview p {
    margin-bottom: 1em;
}

.note-preview ul,
.note-preview ol {
    margin-left: 1.5em;
    margin-bottom: 1em;
}

.note-preview code {
    background: var(--bg-hover);
    padding: 2px 4px;
    border-radius: 4px;
    font-family: monospace;
    font-size: 0.9em;
}

.note-preview pre {
    background: var(--bg-hover);
    padding: 10px;
    border-radius: 6px;
    overflow-x: auto;
    margin-bottom: 1em;
}

.note-preview pre code {
    background: transparent;
    padding: 0;
}

.note-preview blockquote {
    border-left: 4px solid var(--border-color);
    margin-left: 0;
    padding-left: 1em;
    color: var(--text-secondary);
}

/* Buttons */
.btn {
    padding: 8px 16px;
    border-radius: 6px;
    border: none;
    cursor: pointer;
    font-size: 0.9rem;
    font-weight: 500;
    transition: opacity 0.2s;
}

.btn-primary {
    background: var(--accent-color);
    color: var(--btn-text);
}

.btn-danger {
    background: #dc3545;
    color: white;
}

.btn:hover {
    opacity: var(--btn-hover-opacity);
}

.text-accent {
    color: var(--accent-color);
}

.toolbar {
    display: flex;
    justify-content: space-between;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 10px;
}

/* Hide helper data elements */
.step:has(#model-data),
.message:has(#model-data),
.cl-message:has(#model-data),
.message-content:has(#model-data),
div:has(> #model-data) {
    display: none !important;
}

/* Toast */
#model-toast {
    visibility: hidden;
    min-width: 250px;
    margin-left: -125px;
    background-color: var(--bg-secondary);
    color: var(--text-primary);
    text-align: center;
    border-radius: 8px;
    padding: 16px;
    position: fixed;
    z-index: 10000;
    left: 50%;
    top: 30px;
    font-size: 16px;
    box-shadow: 0 4px 12px var(--shadow-color);
    opacity: 0;
    transition: opacity 0.3s, top 0.3s;
    border: 1px solid var(--border-color);
}

#model-toast.show {
    visibility: visible;
    opacity: 1;
    top: 50px;
}

/* Collapsible Category Headers - Features/25_notes_system */
.category-header {
    padding: 8px 10px;
    font-size: 0.85em;
    font-weight: bold;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-radius: 4px;
    margin-top: 5px;
    margin-bottom: 2px;
    transition: background-color 0.2s;
    user-select: none;
}

.category-header:hover {
    background-color: var(--bg-hover);
    color: var(--text-primary);
}

.category-toggle-icon {
    font-size: 0.8em;
    transition: transform 0.2s ease;
    opacity: 0.7;
}

.category-header:hover .category-toggle-icon {
    opacity: 1;
}
